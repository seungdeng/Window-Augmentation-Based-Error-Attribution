# Copy this file to ".env" in the same directory and fill in your key.
# inference.py loads this automatically via python-dotenv.

# Required: your OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: override the API base URL (defaults to OpenRouter's endpoint)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: attribution headers shown on OpenRouter's leaderboards (https://openrouter.ai/docs)
# OPENROUTER_SITE_URL=https://your-app-or-repo-url
# OPENROUTER_SITE_NAME=your-app-name
